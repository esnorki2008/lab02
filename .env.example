# Copiar a .env (cp .env.example .env). Valores de laboratorio: cámbielos fuera de un entorno local.
# --- Base de datos del producto ---
POSTGRES_USER=novamercado
POSTGRES_PASSWORD=cambie-esta-clave
POSTGRES_DB=novamercado
# --- Base de datos de Airflow (separada de la del producto) ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=cambie-esta-clave-airflow
# --- Airflow: usuario de la UI/API REST y secreto de los JWT ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambie-esta-clave-admin
AIRFLOW_JWT_SECRET=cambie-este-secreto-jwt
# --- Puertos publicados en el host (opcionales) ---
API_PORT=8000
MLFLOW_PORT=5000
AIRFLOW_PORT=8080
